<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>AICResourceKit</RootNamespace>
    <AssemblyName>AICResourceKit</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!-- 程序集信息由 Properties\AssemblyInfo.cs 提供 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- 保持与旧式工程一致的输出布局 bin\Debug\，便于拷贝到游戏 plugins 目录 -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- 引用来自解决方案根的 ReferenceLibrary，准备方式见 docs/development.md -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>..\ReferenceLibrary\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\ReferenceLibrary\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>..\ReferenceLibrary\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="better">
      <HintPath>..\ReferenceLibrary\better.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="pixelliner">
      <HintPath>..\ReferenceLibrary\pixelliner.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="spine-unity">
      <HintPath>..\ReferenceLibrary\spine-unity.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\ReferenceLibrary\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\ReferenceLibrary\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>..\ReferenceLibrary\Unity.InputSystem.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\ReferenceLibrary\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
