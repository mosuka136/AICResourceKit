      <Private>False</Private>
    </Reference>
    <Reference Include="UnityModBase">
      <HintPath>..\ReferenceLibrary\UnityModBase.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityModBase.BepInExLauncher">
      <HintPath>..\ReferenceLibrary\UnityModBase.BepInExLauncher.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="unsafeAssem">
      <HintPath>..\ReferenceLibrary\unsafeAssem.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
