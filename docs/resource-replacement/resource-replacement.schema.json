                },
                "display": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "properties": {
                        "skeletonScale": {
                            "type": [
                                "number",
                                "null"
                            ],
                            "minimum": -3.4028234663852886e+38,
                            "maximum": 3.4028234663852886e+38,
                            "exclusiveMinimum": 0
                        },
                        "scaleMultiplier": {
                            "type": [
                                "number",
                                "null"
                            ],
                            "minimum": -3.4028234663852886e+38,
                            "maximum": 3.4028234663852886e+38,
                            "exclusiveMinimum": 0
                        },
                        "offsetX": {
                            "type": [
                                "number",
                                "null"
