                                "null"
                            ],
                            "propertyNames": {
                                "type": "string",
                                "pattern": "\\S"
                            },
                            "additionalProperties": {
                                "type": "string",
                                "pattern": "\\S"
                            }
                        },
                        "skins": {
                            "type": [
                                "object",
                                "null"
                            ],
                            "propertyNames": {
                                "type": "string",
                                "pattern": "\\S"
                            },
                            "additionalProperties": {
                                "type": "string",
                                "pattern": "\\S"
                            }
                        },
                        "bones": {
                            "type": [
                                "object",
                                "null"
                            ],
                            "propertyNames": {
                                "type": "string",
                                "pattern": "\\S"
                            },
                            "additionalProperties": {
                                "type": "string",
                                "pattern": "\\S"
                            }
                        },
                        "animationFallback": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "skinFallback": {
                            "type": [
                                "string",
                                "null"
                            ]
                        }
