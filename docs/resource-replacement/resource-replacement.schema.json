                        },
                        "offsetY": {
                            "type": [
                                "number",
                                "null"
                            ],
                            "minimum": -3.4028234663852886e+38,
                            "maximum": 3.4028234663852886e+38
                        },
                        "width": {
                            "type": [
                                "number",
                                "null"
                            ],
                            "minimum": -3.4028234663852886e+38,
                            "maximum": 3.4028234663852886e+38,
                            "exclusiveMinimum": 0
                        },
                        "height": {
                            "type": [
                                "number",
                                "null"
                            ],
                            "minimum": -3.4028234663852886e+38,
                            "maximum": 3.4028234663852886e+38,
                            "exclusiveMinimum": 0
                        },
                        "rightShift": {
                            "type": [
                                "number",
                                "null"
                            ],
                            "minimum": -3.4028234663852886e+38,
                            "maximum": 3.4028234663852886e+38
                        }
                    }
                },
                "effects": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "properties": {
                        "dirt": {
                            "enum": [
                                "auto",
                                "legacy",
                                "disabled",
                                null
                            ]
                        }
                    }
                }
            },
            "anyOf": [
                {
                    "required": [
                        "image"
                    ],
                    "properties": {
                        "image": {
                            "type": "string"
                        }
                    }
                },
                {
                    "required": [
                        "atlas"
                    ],
                    "properties": {
                        "atlas": {
                            "type": "string"
                        }
                    }
                },
                {
                    "required": [
                        "spine"
                    ],
                    "properties": {
                        "spine": {
                            "type": "object"
                        }
                    }
                },
                {
                    "required": [
                        "effects"
                    ],
                    "properties": {
                        "effects": {
                            "type": "object"
                        }
                    }
                },
                {
                    "required": [
                        "display"
                    ],
                    "properties": {
                        "display": {
                            "type": "object",
                            "anyOf": [
                                {
                                    "required": [
