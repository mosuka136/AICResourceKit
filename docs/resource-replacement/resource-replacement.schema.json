{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "AICResourceKit v2 authoring manifest",
    "description": "Canonical authoring form. ResourceManifest is authoritative for semantic checks and compatibility spellings; this schema does not certify game support or file contents.",
    "type": "object",
    "required": [
        "formatVersion",
        "id",
        "targets"
    ],
    "properties": {
        "formatVersion": {
            "const": 2
        },
        "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*[\\r\\n])(?=.*\\S).+$"
        },
        "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
                "oneOf": [
                    {
                        "$ref": "#/definitions/mti"
                    },
                    {
                        "$ref": "#/definitions/resources"
                    },
                    {
                        "$ref": "#/definitions/spine"
                    }
                ]
            }
        }
    },
    "definitions": {
        "mti": {
            "type": "object",
            "required": [
                "type",
                "loader",
                "assetKey",
                "image"
            ],
            "properties": {
                "type": {
                    "const": "texture"
                },
                "loader": {
                    "const": "mti"
                },
                "assetKey": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!.*[\\r\\n])(?=.*\\S).+$"
                },
                "imageKey": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "image": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?![/\\\\])(?!.*[:\\r\\n\\u0000])(?=.*\\S).+$"
                }
            }
        },
        "resources": {
            "type": "object",
            "required": [
                "type",
                "loader",
                "path",
                "objectType",
                "image"
            ],
            "properties": {
                "type": {
                    "const": "texture"
                },
                "loader": {
                    "const": "resources"
                },
                "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!.*[\\r\\n])(?=.*\\S).+$"
                },
                "objectType": {
                    "enum": [
                        "Texture2D",
                        "Sprite"
                    ]
                },
                "image": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?![/\\\\])(?!.*[:\\r\\n\\u0000])(?=.*\\S).+$"
                }
            }
        },
        "spine": {
            "type": "object",
            "required": [
                "type",
                "key",
                "jsonKey"
            ],
            "properties": {
                "type": {
                    "const": "spine"
                },
                "key": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!.*[\\r\\n])(?=.*\\S).+$"
                },
                "jsonKey": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!.*[\\r\\n])(?=.*\\S).+$"
                },
                "image": {
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^(?![/\\\\])(?!.*[:\\r\\n\\u0000])(?=.*\\S).+$"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "atlas": {
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^(?![/\\\\])(?!.*[:\\r\\n\\u0000])(?=.*\\S).+$"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "spine": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "required": [
                        "json",
                        "replace"
                    ],
                    "properties": {
                        "json": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^(?![/\\\\])(?!.*[:\\r\\n\\u0000])(?=.*\\S).+$"
                        },
                        "replace": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "enum": [
                                    "bones",
                                    "slots",
                                    "constraints",
                                    "skins",
                                    "attachments",
                                    "events",
                                    "animations",
                                    "all"
                                ]
                            },
                            "allOf": [
                                {
                                    "if": {
                                        "contains": {
                                            "const": "all"
                                        }
                                    },
                                    "then": {
                                        "items": {
                                            "const": "all"
                                        }
                                    }
                                },
                                {
                                    "not": {
                                        "allOf": [
                                            {
                                                "contains": {
                                                    "const": "skins"
                                                }
                                            },
                                            {
                                                "contains": {
                                                    "const": "attachments"
                                                }
                                            }
                                        ]
                                    }
                                }
                            ]
                        }
                    }
                },
                "compatibility": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "properties": {
